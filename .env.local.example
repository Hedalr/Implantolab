# =============================================================================
# Backend données / auth
# =============================================================================
# supabase = prod/test actuelles (défaut, ne pas changer en prod tant que cutover)
# postgres = Docker local / futur Scalingo HDS
# Valeurs acceptées UNIQUEMENT : supabase | postgres
# DATA_BACKEND=supabase
# DATA_BACKEND=postgres

# =============================================================================
# Postgres local (Docker — Scalingo-like)
# =============================================================================
# Démarrer : docker compose up -d
# Arrêter  : docker compose down
#
# Requis en production Scalingo si DATA_BACKEND=postgres (pas de fallback).
# En local (NODE_ENV=development), un défaut Docker est utilisé si omis —
# préférer tout de même le définir explicitement :
# DATABASE_URL=postgresql://implantolab:implantolab@localhost:5432/implantolab
# LOCAL_STORAGE_ROOT=.data/storage
# Symlinks sous LOCAL_STORAGE_ROOT : refusés (fail-closed) par lib/storage/local.ts.
#
# Seed local (fictif) : npm run db:migrate && npm run db:seed
# Comptes : *@local.dev / ImplantolabDev1!
#
# Interdit en production : URL localhost / credentials Docker implantolab.

# =============================================================================
# Espace praticien — Supabase
# =============================================================================
# Créer un projet sur https://supabase.com puis récupérer les clés dans
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Optionnel — scripts admin uniquement, ne jamais exposer côté client
# Requis pour inviter des praticiens depuis /espace-praticien/admin/praticiens
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# URL publique du site (invitations e-mail, callbacks auth, fallback redirects)
# Sur Scalingo : https://votre-app.osc-fr1.scalingo.io (évite redirect → localhost:$PORT)
# NEXT_PUBLIC_SITE_URL=https://www.implantolab.fr

# Secret du cron Vercel (`/api/cron/purge-request-media`) — même valeur à
# définir dans le dashboard Vercel (Environment Variables → CRON_SECRET).
# Vercel envoie `Authorization: Bearer <CRON_SECRET>` à chaque exécution.
# En DATA_BACKEND=postgres : longueur min 32 (fail-closed si trop court).
# CRON_SECRET=générer-une-chaine-longue-aleatoire-min-32-chars

# =============================================================================
# Notifications push (app mobile — voir docs/push-notifications.md)
# =============================================================================
# Secret partagé pour les Database Webhooks Supabase → /api/push/*
# En DATA_BACKEND=postgres : longueur min 32 (fail-closed si trop court).
# PUSH_WEBHOOK_SECRET=générer-une-chaine-longue-aleatoire-min-32-chars

# TTL optionnel (jours) : purge les push_tokens non rafraîchis (`updated_at`)
# lors du cron `/api/cron/purge-request-media`. Absent = désactivé.
# Handoff appareil sans unregister → 409 volontaire tant que la row existe ;
# un TTL (ex. 90) libère le token après inactivité pour un nouveau compte.
# PUSH_TOKEN_TTL_DAYS=90

# Token de vérification Notion (handshake webhook) → /api/webhooks/notion
# NOTION_WEBHOOK_SECRET=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Actualités Notion (optionnel — voir docs/notion-setup.md)
# =============================================================================
# NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NOTION_DATABASE_ID=12ab34cd56ef7890abcdef1234567890

# =============================================================================
# Offres de recrutement Notion (optionnel — voir docs/notion-recrutement-setup.md)
# =============================================================================
# Réutilise le même NOTION_TOKEN que ci-dessus (même intégration Notion),
# avec une base dédiée aux offres d'emploi.
# NOTION_JOBS_DATABASE_ID=12ab34cd56ef7890abcdef1234567890

# =============================================================================
# Notification "Modifications prothèse" (impression d'étiquette labo)
# =============================================================================
# Quand un dentiste crée une demande "Modifications prothèse", un email est
# envoyé automatiquement à une boîte dédiée qui déclenche l'impression d'une
# étiquette côté laboratoire (règle Outlook + imprimante Brother QL-800).
#
# Clé API Resend — https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Expéditeur des emails. En sandbox Resend, seule l'adresse
# onboarding@resend.dev fonctionne sans domaine vérifié (envoi limité).
# Pour la prod, vérifier un domaine (ex. implantolab.fr) dans Resend puis
# utiliser une adresse de ce domaine.
# RESEND_FROM_EMAIL="Implantolab <onboarding@resend.dev>"

# Boîte mail qui déclenche l'impression de l'étiquette (créée côté labo,
# voir docs). Par défaut : modif-prothese@outlook.fr
#
# RGPD — à renseigner en production : l'email contient un nom de patient et la
# description de la modification, donc des données de santé. La valeur par
# défaut pointe vers une boîte Outlook grand public ; viser une adresse du
# domaine implantolab.fr, sur une messagerie professionnelle maîtrisée.
# PROTHESE_REQUEST_NOTIFICATION_EMAIL=modif-prothese@outlook.fr
